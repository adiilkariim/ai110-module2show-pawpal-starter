classDiagram
    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(pet: Pet) None
        +update_preferences(preferences: dict) None
        +get_all_tasks() list~tuple~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
        +edit_task(task: Task, changes: dict) None
        +get_tasks() list~Task~
        +get_task_count() int
    }

    class Task {
        +str description
        +str due_time
        +int duration_minutes
        +str priority
        +str category
        +str frequency
        +bool is_complete
        +mark_complete() None
        +get_duration() int
    }

    class Scheduler {
        +Owner owner
        +str day_start
        +get_all_tasks() list~tuple~
        +sort_tasks(tasks: list~tuple~) list~tuple~
        +filter_tasks(tasks: list~tuple~) list~tuple~
        +check_conflicts(tasks: list~tuple~) list~str~
        +generate_plan() DailyPlan
    }

    class ScheduledTask {
        +str pet_name
        +Task task
        +str start_time
        +str end_time
        +str reason
    }

    class DailyPlan {
        +str owner_name
        +list~ScheduledTask~ scheduled_tasks
        +list~Task~ skipped_tasks
        +list~str~ reasoning
        +display_plan() str
        +explain_reasoning() str
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Scheduler --> Owner : plans for
    Scheduler ..> Task : organizes
    Scheduler ..> DailyPlan : generates
    DailyPlan "1" --> "0..*" ScheduledTask : includes
    ScheduledTask --> Task : wraps
